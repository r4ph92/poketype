# Copy to .env and adjust. Placeholder values only; never commit real credentials.
DATABASE_URL=postgres://poketype:poketype@localhost:5432/poketype
TEST_DATABASE_URL=postgres://poketype:poketype@localhost:5432/poketype_test
# Production only (Vercel + Neon): direct connection for migrations during the build; falls back to DATABASE_URL.
# DATABASE_URL_UNPOOLED=postgres://user:password@host/poketype
POSTGRES_USER=poketype
POSTGRES_PASSWORD=poketype
# Optional: port for the e2e app server (default 3100); the database outage test uses the next port.
# E2E_PORT=3100
# Optional: the seed (npm run db:seed) refuses a non-local database unless this is set to allow.
# SEED_ACCOUNTS=allow
# Password of the seeded test account "ash" (every Pokémon and badge). Without it, the seed skips ash. 8 to 128 characters.
SEED_ASH_PASSWORD=change-me-ash-password
# Live room updates by push (Pusher protocol). Leave all PUSHER_* unset for polling only; setting some but not all fails the build.
# Local and CI: the soketi service from docker-compose.yml (docker compose up -d soketi) reads these same values.
PUSHER_APP_ID=local-app-id
PUSHER_KEY=local-app-key
PUSHER_SECRET=local-app-secret
PUSHER_HOST=localhost
PUSHER_PORT=6001
PUSHER_USE_TLS=false
# Production (Pusher Channels): set PUSHER_CLUSTER (for example eu) instead of PUSHER_HOST, PUSHER_PORT and PUSHER_USE_TLS.
# PUSHER_CLUSTER=eu
# Sign in with GitHub and Discord (optional). A provider's button stays disabled until both its ID and secret are set.
# Register the apps as described in README.md ("Sign in with GitHub and Discord"). Never commit real values.
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret
# DISCORD_CLIENT_ID=your-discord-client-id
# DISCORD_CLIENT_SECRET=your-discord-client-secret
# Optional: the public address the provider callbacks use; without it, the address of the request (http://localhost:3000 locally).
# PUBLIC_BASE_URL=https://your-production-domain
