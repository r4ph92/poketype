# Copy to .env and adjust. Placeholder values only; never commit real credentials.
DATABASE_URL=postgres://poketype:poketype@localhost:5432/poketype
TEST_DATABASE_URL=postgres://poketype:poketype@localhost:5432/poketype_test
POSTGRES_USER=poketype
POSTGRES_PASSWORD=poketype
# Optional: port for the e2e app server (default 3100); the database outage test uses the next port.
# E2E_PORT=3100
# Optional: the seed (npm run db:seed) refuses a non-local database unless this is set to allow.
# SEED_ACCOUNTS=allow
