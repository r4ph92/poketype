# Copy to .env and adjust. Placeholder values only; never commit real credentials.
DATABASE_URL=postgres://poketype:poketype@localhost:5432/poketype
TEST_DATABASE_URL=postgres://poketype:poketype@localhost:5432/poketype_test
POSTGRES_USER=poketype
POSTGRES_PASSWORD=poketype
# Optional: port for the e2e app server (default 3100); the database outage test uses the next port.
# E2E_PORT=3100
# Optional: the seed (npm run db:seed) refuses a non-local database unless this is set to allow.
# SEED_ACCOUNTS=allow
# Live room updates by push (Pusher protocol). Leave all PUSHER_* unset for polling only; setting some but not all fails the build.
# Local and CI: the soketi service from docker-compose.yml (docker compose up -d soketi) reads these same values.
PUSHER_APP_ID=local-app-id
PUSHER_KEY=local-app-key
PUSHER_SECRET=local-app-secret
PUSHER_HOST=localhost
PUSHER_PORT=6001
PUSHER_USE_TLS=false
# Production (Pusher Channels): set PUSHER_CLUSTER (for example eu) instead of PUSHER_HOST, PUSHER_PORT and PUSHER_USE_TLS.
# PUSHER_CLUSTER=eu
